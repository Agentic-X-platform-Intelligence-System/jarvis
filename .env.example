# Copy to ".env" and fill in values.

# --- Required for LLM ---
ANTHROPIC_API_KEY=

# Optional model override (default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Wake word (Picovoice Porcupine) ---
# Get an access key from Picovoice Console: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=

# Built-in keyword name (default: jarvis). Picovoice built-ins vary by version.
# PORCUPINE_BUILTIN_KEYWORD=jarvis

# Optional: path to a custom keyword file (.ppn) for a phrase like "Hey JARVIS"
# PORCUPINE_KEYWORD_PATH=C:\\path\\to\\hey_jarvis_windows.ppn

# --- Skills ---
OPENWEATHER_API_KEY=
SERPER_API_KEY=

# --- Optional tuning ---
# JARVIS_SAMPLE_RATE=16000
# JARVIS_RECORD_SECONDS=5.0
# WHISPER_MODEL_SIZE=base
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=int8
# TTS: auto (Coqui if installed, else Edge) | coqui | edge
# JARVIS_TTS_BACKEND=auto
# EDGE_TTS_VOICE=en-US-GuyNeural
# TTS_MODEL_NAME=tts_models/en/ljspeech/tacotron2-DDC
# MAX_CONVERSATION_TURNS=10
# API_TIMEOUT_SECONDS=120
